# =============================================================================
# WineGuard — variáveis de ambiente
# Copie para ".env" (ignorado pelo git) e ajuste. Usado pelo docker compose;
# para rodar o backend fora do Docker, exporte as mesmas variáveis no terminal.
# =============================================================================

# ---------- Banco (PostgreSQL) ----------
POSTGRES_DB=wineguard
POSTGRES_USER=wineguard
POSTGRES_PASSWORD=troque-esta-senha
# Usado pelo backend fora do Docker (no compose é montado automaticamente)
DATABASE_URL=jdbc:postgresql://localhost:5432/wineguard
DATABASE_USERNAME=wineguard
DATABASE_PASSWORD=troque-esta-senha

# ---------- Backend ----------
# fiware = Orion/IoT Agent/STH-Comet reais | standalone = sem FIWARE (só dispositivos virtuais)
WINEGUARD_MODE=fiware
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
SEED_DEVICES=true
TELEMETRY_POLL_INTERVAL_MS=2000
ACTUATION_RESYNC_SECONDS=20
SIMULATOR_PUBLISH_INTERVAL_MS=5000

# ---------- FIWARE ----------
# Docker local (compose --profile fiware): nomes internos já são o padrão.
# VM remota (ex.: FIWARE Descomplicado na Azure): use o IP público, ex.:
#   FIWARE_ORION_URL=http://20.0.0.10:1026
#   FIWARE_IOTA_URL=http://20.0.0.10:4041
#   FIWARE_STH_URL=http://20.0.0.10:8666
#   MQTT_BROKER_URL=tcp://20.0.0.10:1883
#   FIWARE_STH_NOTIFY_URL=http://20.0.0.10:8666/notify   (URL que o ORION usa para chegar ao STH)
FIWARE_ORION_URL=http://orion:1026
FIWARE_IOTA_URL=http://iot-agent:4041
FIWARE_STH_URL=http://sth-comet:8666
FIWARE_SERVICE=smart
FIWARE_SERVICE_PATH=/
FIWARE_API_KEY=TEF
FIWARE_ENTITY_TYPE=WineSensor
# URL do Orion vista pelo IoT Agent / URL do STH vista pelo Orion (rede interna do FIWARE)
FIWARE_IOTA_CBROKER_URL=http://orion:1026
FIWARE_STH_NOTIFY_URL=http://sth-comet:8666/notify
FIWARE_AUTO_PROVISION=true
FIWARE_TIMEOUT_MS=4000

# ---------- MQTT (dispositivos virtuais do backend) ----------
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ---------- Frontend (vite dev) ----------
# Destino do proxy /api no "npm run dev"
VITE_BACKEND_URL=http://localhost:8080
